# Copy to .env.local for local-only variables (never commit .env.local).
# In Create React App, only variables prefixed with REACT_APP_ are exposed to the browser.

# REACT_APP_EXAMPLE=

# Formspree form endpoint for the consulting page lead capture form.
# Create a form at https://formspree.io and paste the endpoint here.
# REACT_APP_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
